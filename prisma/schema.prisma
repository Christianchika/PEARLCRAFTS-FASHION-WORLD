generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id            String   @id
  name          String
  description   String
  price         Int
  category      String
  colour        String?
  stockQuantity Int
  imageUrl      String
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems OrderItem[]
}

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Order {
  id             String      @id @default(cuid())
  customerId     String
  deliveryMethod String
  notes          String?
  status         OrderStatus @default(PENDING)
  totalAmount    Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer Customer    @relation(fields: [customerId], references: [id])
  items    OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Int
  subtotal  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

model CustomOrder {
  id                   String                     @id @default(cuid())
  fullName             String
  phone                String
  email                String?
  location             String
  itemType             String
  occasion             String?
  preferredColour      String?
  quantity             Int                        @default(1)
  description          String
  deliveryMethod       String?
  quotedAmount         Int?
  quoteNotes           String?
  quoteValidUntil      DateTime?
  quotedAt             DateTime?
  status               CustomOrderStatus          @default(PENDING)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  attachments          CustomOrderAttachment[]
  uploads              CustomOrderUpload[]
  uploadTokenHash      String?                    @unique
  uploadTokenExpiresAt DateTime?
  statusHistory        CustomOrderStatusHistory[]
}

model CustomOrderStatusHistory {
  id             String             @id @default(cuid())
  customOrderId  String
  fromStatus     CustomOrderStatus?
  toStatus       CustomOrderStatus
  changedById    String?
  changedByName  String?
  changedByEmail String?
  createdAt      DateTime           @default(now())

  customOrder CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)

  @@index([customOrderId])
  @@index([createdAt])
}

model CustomOrderAttachment {
  id            String   @id @default(cuid())
  customOrderId String
  fileName      String
  fileUrl       String
  contentType   String?
  fileSize      Int?
  createdAt     DateTime @default(now())

  customOrder CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
}

enum CustomOrderStatus {
  PENDING
  REVIEWED
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CustomOrderUpload {
  id            String       @id @default(cuid())
  customOrderId String
  objectKey     String       @unique
  fileName      String
  contentType   String
  expectedSize  Int
  status        UploadStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  customOrder CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)

  @@index([customOrderId])
  @@index([status])
}

enum UploadStatus {
  PENDING
  COMPLETED
}

model Video {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  videoUrl    String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}
